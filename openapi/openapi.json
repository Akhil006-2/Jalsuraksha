            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_photo_api_v1_reports_photo_post"
      },
      "Coordinate": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Coordinate"
      },
      "Depth": {
        "type": "string",
        "enum": [
          "ankle",
          "knee",
          "waist_or_stalled_cars",
          "unknown"
        ],
        "title": "Depth"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Report": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "depth": {
            "$ref": "#/components/schemas/Depth"
          },
          "reporter_id": {
            "type": "string",
            "title": "Reporter Id"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "photo_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Key"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "latitude",
          "longitude",
          "depth",
          "reporter_id",
          "description",
          "photo_key",
          "observed_at",
          "received_at",
          "status"
        ],
        "title": "Report"
      },
      "ReportCreate": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "depth": {
            "$ref": "#/components/schemas/Depth"
          },
          "reporter_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Reporter Id",
            "description": "Opaque app identifier; do not submit a real name."
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "photo_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Key"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "depth",
          "reporter_id"
        ],
        "title": "ReportCreate"
      },
      "ReportUpdate": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Status"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "title": "ReportUpdate"
      },
      "RouteRequest": {
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "destination": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle",
            "default": "sedan"
          },
          "alternatives": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Alternatives",
            "default": 3
          },
          "avoid_uncertain_hazards": {
            "type": "boolean",
            "title": "Avoid Uncertain Hazards",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "origin",
          "destination"
        ],
        "title": "RouteRequest"
      },
      "Status": {
        "type": "string",
        "enum": [
          "new",
          "corroborated",
          "verified",
          "resolved",
          "rejected"
        ],
        "title": "Status"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Vehicle": {
        "type": "string",
        "enum": [
          "pedestrian",
          "two_wheeler",
          "sedan",
          "ambulance",
          "emergency_vehicle"
        ],
        "title": "Vehicle"
      }
    }
